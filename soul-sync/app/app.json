{
  "expo": {
    "name": "Soul Sync",
    "slug": "soul-sync",
    "scheme": "soulsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.soulsync.pilot",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.soulsync.pilot",
      "adaptiveIcon": {
        "backgroundColor": "#F3EEE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        { "color": "#7A5C3E" }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Soul Sync reads your sleep, heart rate variability, resting heart rate and steps to tailor your one daily card. Your data is never sold or shared.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": { "minSdkVersion": 26 }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": { "projectId": "REPLACE_WITH_EAS_PROJECT_ID" }
    }
  }
}
